# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- вывод тестов и прогонов ---
tests/vyvod/
tests/selftest_out/

# --- файлы SolidWorks ---
# Модели в репозиторий не кладём: это инструмент, а не архив проектов.
# Тестовые модели пересоздаются запуском tests/.
*.SLDPRT
*.SLDASM
*.SLDDRW
*.STEP
*.STP
*.IGS
*.X_T
*.STL
# служебные метки блокировки SolidWorks
~$*

# --- стоп-лист: приметы изделий этой машины ---
# Только локально. Лежавший в репозитории стоп-лист сам публиковал названия,
# которые должен был скрывать (knowledge/40_СРЕДА/40-02). Заводит setup.ps1.
tools/stoplist.txt

